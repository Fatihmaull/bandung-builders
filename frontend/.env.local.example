# Copy to `.env.local` (gitignored) and fill in.

# WalletConnect Cloud projectId. Free at https://cloud.walletconnect.com/.
# Required by RainbowKit's `getDefaultConfig`.
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Deployed contract addresses on Base Sepolia.
# These are emitted by `forge script script/Deploy.s.sol:Deploy ...`.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STAKING_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: custom RPC. Defaults to the Wagmi-provided public endpoint.
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
