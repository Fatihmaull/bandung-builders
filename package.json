{
  "name": "bandungbuildmaterial",
  "version": "0.2.0",
  "private": true,
  "description": "Bandung L2 DeFi Staking Workshop — multi-track monorepo (Base, Optimism, Arbitrum Sepolia).",
  "workspaces": [
    "tracks/base/frontend",
    "tracks/optimism/frontend",
    "tracks/arbitrum/frontend"
  ],
  "scripts": {
    "dev:base": "pnpm --filter @bandung/frontend-base dev",
    "dev:optimism": "pnpm --filter @bandung/frontend-optimism dev",
    "dev:arbitrum": "pnpm --filter @bandung/frontend-arbitrum dev",
    "build:base": "pnpm --filter @bandung/frontend-base build",
    "build:optimism": "pnpm --filter @bandung/frontend-optimism build",
    "build:arbitrum": "pnpm --filter @bandung/frontend-arbitrum build",
    "test:base": "cd tracks/base/contracts && forge test -vvv",
    "test:optimism": "cd tracks/optimism/contracts && forge test -vvv",
    "test:arbitrum": "cd tracks/arbitrum/contracts && forge test -vvv",
    "build:contracts:base": "cd tracks/base/contracts && forge build",
    "build:contracts:optimism": "cd tracks/optimism/contracts && forge build",
    "build:contracts:arbitrum": "cd tracks/arbitrum/contracts && forge build"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
